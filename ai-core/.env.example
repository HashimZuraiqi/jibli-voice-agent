# Copy to .env and fill in. Never commit .env.
# LLM: bedrock (default, Claude on Amazon Bedrock) or openrouter (fallback)
LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL=global.anthropic.claude-sonnet-5-5
BEDROCK_MEMORY_MODEL=global.anthropic.claude-haiku-5-5
# Event credentials expire every hour: open link.careem.com/htjordan, click A, paste the three values here.
# The next LLM call reloads them, no restart needed.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# OpenRouter fallback (LLM_PROVIDER=openrouter). Free tier: 50 requests/day per account.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
LLM_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
LLM_BASE_URL=https://openrouter.ai/api/v1
# true = Mem0 uses the LLM to extract facts from each message (+1-2 calls per message); false = store the message as is
MEM0_INFER=true

# Careem services: mcp = Careem's tools through careem-mcp (start the local sandbox first:
#   .venv/bin/python careem-mcp-sandbox/careem_mcp.py start); mock = the offline JSON catalog
CAREEM_MODE=mcp
CAREEM_MCP_URL=http://127.0.0.1:8787/mcp
