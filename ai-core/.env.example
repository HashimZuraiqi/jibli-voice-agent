# Copy to .env and fill in. Never commit .env.
# LLM: bedrock (default, Claude on Amazon Bedrock) or openrouter (fallback)
LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL=global.anthropic.claude-sonnet-5-5
BEDROCK_MEMORY_MODEL=global.anthropic.claude-haiku-5-5
# Event credentials expire every hour: open link.careem.com/htjordan, click A, paste the three values here.
# The next LLM call reloads them, no restart needed.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Memory: agentcore (what we demo: Amazon Bedrock AgentCore Memory, JibliMemory-ABaSFyHMkk) or mem0 (local backup)
MEMORY_PROVIDER=agentcore
# run scripts/create_agentcore_memory.py once and paste the id it prints
AGENTCORE_MEMORY_ID=
# true = also save the raw sentence instantly so the demo shows it at once (AgentCore's own extraction takes a bit)
AGENTCORE_INSTANT_FACTS=true

# Careem: mock (default, local data) or mcp (real Careem MCP server)
CAREEM_PROVIDER=mock
CAREEM_MCP_URL=
CAREEM_MCP_TOKEN=
# http (streamable HTTP) or sse
CAREEM_MCP_TRANSPORT=http
# fallback delivery location when user_info has no saved address (default: Amman)
CAREEM_LAT=31.9539
CAREEM_LNG=35.9106

# OpenRouter fallback (LLM_PROVIDER=openrouter). Free tier: 50 requests/day per account.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
LLM_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
LLM_BASE_URL=https://openrouter.ai/api/v1
# true = Mem0 uses the LLM to extract facts from each message (+1-2 calls per message); false = store the message as is
MEM0_INFER=true
